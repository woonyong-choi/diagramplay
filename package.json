{
  "name": "diagramplay",
  "version": "0.3.0",
  "description": "Animated architecture, card flow, sequence, entity relationship, and class diagrams from text",
  "license": "MIT",
  "keywords": [
    "diagram",
    "animation",
    "svg",
    "markdown",
    "documentation",
    "simulation",
    "async",
    "sequence-diagram",
    "cli",
    "erd",
    "class-diagram"
  ],
  "author": "choi woo-nyong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woonyong-choi/diagramplay.git"
  },
  "homepage": "https://github.com/woonyong-choi/diagramplay#readme",
  "bugs": {
    "url": "https://github.com/woonyong-choi/diagramplay/issues"
  },
  "type": "module",
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "bin": {
    "diagramplay": "src/cli.js"
  },
  "scripts": {
    "test": "node --test --test-concurrency=2 test/*.test.js",
    "test:browser": "node --test test/browser/*.test.js",
    "grammar": "node scripts/build-grammar-doc.mjs",
    "fuzz": "node scripts/fuzz-layout.mjs",
    "perf": "node scripts/perf-chips.mjs",
    "checkdoc": "node scripts/build-check-doc.mjs",
    "check": "design-tokens-check src --tokens node_modules/@woonyong-choi/design-tokens/dist/tokens.json",
    "check:docs": "node scripts/build-grammar-doc.mjs --check && node scripts/build-check-doc.mjs --check",
    "check:sources": "node src/cli.js check examples/*.diagramplay docs/assets/*.diagramplay docs/assets/showcase/*.diagramplay --strict",
    "check:figures": "node scripts/run-md.mjs --check --strict && node scripts/build-showcase.mjs --check",
    "check:advisory": "node scripts/check-cost-comments.mjs --advisory src test && node scripts/check-size.mjs --advisory src scripts",
    "showcase": "node scripts/build-showcase.mjs",
    "figures": "npm run catalog && node src/cli.js render docs/assets/how-it-works.diagramplay && npm run showcase && node scripts/run-md.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "check:package": "node scripts/check-package.mjs",
    "compare": "node scripts/build-comparison.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo-google-fonts/noto-sans-math": "^0.4.2",
    "@woonyong-choi/design-tokens": "https://raw.githubusercontent.com/woonyong-choi/design-tokens/ff2cf317b8b97c2cfc2037742668ab3dc3a44bd1/artifacts/diagram.tgz",
    "elkjs": "^0.9.3",
    "fontkit": "^2.0.4",
    "jetbrains-mono": "^1.0.6",
    "postcss": "8.5.29",
    "pretendard": "^1.3.9",
    "subset-font": "^2.9.0"
  },
  "bundleDependencies": [
    "@woonyong-choi/design-tokens"
  ],
  "acceptDependencies": {
    "@woonyong-choi/design-tokens": "0.2.0"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "typescript": "7.0.2"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  }
}
