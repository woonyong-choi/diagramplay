diagramplay
title "When orders rush in"
subtitle "Orders from the web, the app, and a partner reach the order API together, and the in-flight count and the stock change"

box web "Web"
box app "App"
box partner "Partner"
box api "Order API"
store db "Stock DB"
box pay "Payment"

value stock "Stock" on=db from=120
value shown "Stock in app" on=app ref=stock
value pending "In flight" on=api
on api pending+1
on db pending-1, stock-1

web -> api
app -> api
partner -> api
api -> db
api -> pay

view graph down

scene "Concurrent orders" mode=loop for=6s
  track web, app, partner -> api -> db "order" every=2s time=2400ms
  track api -> pay "charge" at=500ms every=3s time=1800ms tone=orange
