diagramplay
title "클라우드 구성"
subtitle "웹 요청은 DNS, CDN, 로드 밸런서, 웹 서버를 지나 앱 서버에 닿고(1~6), 운영자는 VPN과 배스천으로 들어온다(7~9)"

person user "웹 사용자"
person admin "운영자" icon=admin
group net "인터넷" dashed direction=right {
  box dns "DNS"
  box cdn "CDN"
}
group cloud "클라우드" direction=down dashed {
  box lb "로드 밸런서"
  box web "웹 서버" count=3
  box app "앱 서버"
  group data "데이터" direction=right {
    store db "DB 주 서버" badge="RW"
    store cache "캐시" badge="RW"
  }
  box vpn "VPN"
  box bastion "배스천"
}

user -> dns no=1
dns -> cdn no=2
cdn -> lb no=3
lb -> web no=4
web -> app no=5
app -> db no=6
admin -> vpn no=7
vpn -> bastion no=8
bastion -> app no=9
app -> cache

view graph down

scene "요청 경로" mode=static
  user -> dns
  dns -> cdn
  cdn -> lb
  lb -> web
  web -> app
  app -> db
