diagramplay
pace 900ms
title "04 · 토큰 탈취의 영향"
subtitle "설명용 모형 · 짧은 만료는 피해 시간을 제한하며 탈취 위험 자체를 없애지는 않는다"
icons story "icons" paint=source
box browser "브라우저" icon=story:browser
box thief "공격자" icon=story:attacker tone=red
box api "API 서버" icon=story:server {
  value ttl "남은 분" from=2
}
box auth "인가 서버" icon=story:refresh
browser -> thief "탈취된 토큰" dashed
thief -> api "Bearer 요청" no=1
thief -> auth "갱신 요청" dashed
view graph right
scene "액세스 토큰 탈취" mode=loop
  browser -> thief
  thief -> api
  show api "만료 전에는 악용 가능" tone=red appearance=filled
  wait 1000ms
  thief -> api set="ttl=0"
  show api "만료 후 요청 거부" tone=green appearance=filled
  wait 1600ms
scene "갱신 권한 폐기" mode=loop
  light auth
  show auth "리프레시 토큰 폐기" tone=yellow appearance=filled
  thief -> auth
  show auth "재발급 거부" tone=red appearance=filled
  wait 1800ms
