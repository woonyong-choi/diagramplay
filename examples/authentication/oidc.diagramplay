diagramplay
pace 900ms
title "07 · OIDC는 신원 증명을 더한다"
subtitle "설명용 모형 · ID 토큰은 앱의 로그인 확인에, 액세스 토큰은 API 접근에 사용한다"
box app "클라이언트"
box provider "계정 제공자"
box identity "ID 토큰" tone=blue
box access "Access" tone=yellow
box api "리소스 API"
app -> provider "scope=openid" no=1
provider -> identity "신원 증명" no=2
provider -> access "접근 권한" no=3
identity -> app "로그인 확인" dashed
access -> api "API 요청" no=4
view graph right
scene "두 토큰의 사용처" mode=loop
  app -> provider
  provider -> identity & provider -> access
  show identity "sub: user-7" mono
  show identity "iss · aud · exp · nonce" mono
  show access "scope: photos.read" mono
  identity -> app
  show app "서명·클레임 검증 후 로그인" tone=green appearance=filled
  access -> api
  show api "권한 범위 확인" tone=green appearance=filled
  wait 1800ms
scene "ID 토큰의 내용" mode=static
  show identity "sub: user-7" mono
  show identity "name: 민수" mono
  show identity "iss: 계정 제공자" mono
  show identity "aud: 이 클라이언트" mono
  show identity "exp: 만료 시각" mono
