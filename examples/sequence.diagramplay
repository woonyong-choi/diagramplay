diagramplay
title "주문 처리 순서"
subtitle "동시 조회와 선택한 결제 경로, 재시도, 작업자의 생명주기"
pace 800ms
person user "사용자"
box api "주문 API"
box stock "재고 서비스"
box pay "결제 서비스"
box worker "작업자"
view sequence {
  user api stock pay worker
}
scene "주문 승인"
  user -> api "주문"
  activate api
  fragment par "동시 확인" {
    branch "재고" {
      api -> stock "수량 확인"
      stock -> api "예약 가능" dashed
    }
    branch "결제" {
      api -> pay "결제 수단 확인"
      pay -> api "유효" dashed
    }
  }
  fragment alt "승인 결과" choose="성공" {
    branch "성공" {
      api -> pay "승인 요청"
      pay -> api "승인" dashed
    }
    branch "실패" {
      api -> user "실패 안내"
    }
  }
  fragment opt "알림" run=on {
    api -> user "주문 접수"
  }
  api -> worker "작업 생성" create
  worker -> api "처리 완료" dashed
  api -> worker "작업 종료" destroy
  api -> user "주문 완료" dashed
  deactivate api
scene "결제 재시도"
  user -> api "다시 주문"
  fragment loop "승인 확인" times=2 {
    api -> pay "승인 상태 조회"
    pay -> api "확인 중" dashed
  }
  api -> user "접수 완료" dashed
